{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VPN-GNA Profiles Storage Schema",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "vpn_type", "username", "gateways"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "vpn_type": {
            "type": "string",
            "enum": ["ssl", "ipsec"],
            "default": "ssl"
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "gateways": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["host", "port"],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          },
          "otp_enabled": {
            "type": "boolean",
            "default": false
          },
          "dns_domain": {
            "type": "string"
          },
          "trusted_cert": {
            "type": "string"
          },
          "ike_version": {
            "type": "integer",
            "enum": [1, 2],
            "default": 2
          }
        }
      }
    }
  }
}
